# --- whspr (nix / models / os) ---
/target
result
result-*
/models
.direnv/
*.gguf
*.bin
*.ggml
.DS_Store

# --- app icon rasters (generated, not sources -- see crates/whspr-app/build.rs) ---
# Only assets/icon.svg (and the app-icon/ design-direction *.svg sources) is
# committed; the window icon itself is rasterized from it at build time.
# These patterns keep a stray `sips`/`iconutil` export from being re-added.
*.icns
*.iconset/
crates/whspr-app/assets/app-icon/*.png

# --- macOS bundle outputs (generated by scripts/bundle-macos.sh) ---
# The .app / .dmg / .zip and their icns are assembled at bundle time from
# committed sources; never checked in (see the no-committed-binaries rule).
/dist/
*.app/
*.dmg

# --- Archivo fonts (fetched hermetically by flake.nix, not vendored --
# see crates/whspr-app/build.rs and ARCHIVO_DIR) ---
crates/whspr-app/assets/fonts/*.ttf

# --- Rust / Cargo (upstream template) ---
debug
**/*.rs.bk
*.pdb
**/mutants.out*/

# --- Design comps / references (read from Downloads, never tracked) ---
*.dc.html
